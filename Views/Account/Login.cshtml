@model WebNhaTro.Models.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="d-flex justify-content-center align-items-center">
    <div class="card p-4" style="width: 400px;">
        <h2 class="text-center">Đăng nhập</h2>
        <form method="post" asp-action="Login">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label for="username" class="form-label">Số điện thoại</label>
                <input type="text" id="phone" name="Phone" class="form-control border-orange" required>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Mật khẩu</label>
                <input type="password" id="password" name="Password" class="form-control border-orange" required>
            </div>
            <span id="wrong" class="text-danger"></span>

            <div class="d-flex justify-content-end align-items-center mb-3">
                <a href="#" class="text-primary">Quên mật khẩu?</a>
            </div>

            <button type="submit" id="submit-login" class="btn btn-primary w-100">Đăng nhập</button>
        </form>

        <p class="mt-3 text-center">
            Chưa có tài khoản? <a asp-action="Register" class="text-primary">Đăng ký</a>
        </p>
    </div>
</div>
<script src="/lib/jquery/dist/jquery.min.js"></script> 
<script src="/js/dashboard.js"></script> 
@*khi có kết nổi mạng <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script> *@
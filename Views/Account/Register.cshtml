@model WebNhaTro.Models.RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký";
}

<div class="d-flex justify-content-center align-items-center">
    <div class="card p-4" style="width: 400px;">
        <h2 class="text-center">Đăng ký</h2>
        <form method="post" asp-action="Register">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label for="username" class="form-label">Họ và tên</label>
                <input type="text" id="username" name="FullName" class="form-control border-orange" required>
            </div>

            <div class="mb-3">
                <label for="phone" class="form-label">Số điện thoại</label>
                <input type="tel" id="phone" name="Phone" pattern="[0-9]{10,11}" class="form-control border-orange" required>
            </div>

            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" id="email" name="Email" class="form-control border-orange" required>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Mật khẩu</label>
                <input type="password" id="password" name="Password" class="form-control border-orange" required>
            </div>

            <div class="mb-3">
                <label for="confirmPassword" class="form-label">Xác nhận mật khẩu</label>
                <input type="password" id="confirmPassword" name="ConfirmPassword" class="form-control border-orange" required>
                <span id="wrongCP" class="text-danger"></span>
            </div>

            <div class="mb-3 d-flex justify-content-start">
                <label class="form-label fw-medium m-0">Loại tài khoản</label>
                <div class="form-check ms-3">
                    <input type="radio" id="user_type_guest" name="user_type" value="NguoiThue" class="form-check-input" checked>
                    <label for="user_type_guest" class="form-check-label">Tìm kiếm</label>
                </div>
                <div class="form-check ms-3">
                    <input type="radio" id="user_type_owner" name="user_type" value="ChuTro" class="form-check-input">
                    <label for="user_type_owner" class="form-check-label">Chủ nhà</label>
                </div>
            </div>
            <span id="wrong" class="text-danger"></span>

            <button type="submit" id="submit-register"class="btn btn-primary w-100">Đăng ký</button>
        </form>

        <p class="mt-3 text-center">
            Đã có tài khoản? <a asp-action="Login" class="text-primary">Đăng nhập</a>
        </p>
    </div>
</div>


<script src="/lib/jquery/dist/jquery.min.js"></script> 
<script src="/js/dashboard.js"></script> 
@*khi có kết nổi mạng <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script> *@
